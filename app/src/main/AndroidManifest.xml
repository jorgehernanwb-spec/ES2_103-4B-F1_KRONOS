<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/kronos_icono_final"
        android:label="@string/app_name"
        android:roundIcon="@drawable/kronos_icono_final"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiPrimeraAplicacion">
        <activity
            android:name=".views.BienvenidaActivity"
            android:exported="false" />
        <activity
            android:name=".views.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".views.MainActivity2"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".views.PreferenciasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".views.RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".views.ListaActivity"
            android:exported="false" />

        <activity
            android:name=".views.FormularioLecturaActivity"
            android:exported="false" />

        <activity
            android:name=".views.VentilacionActivity"
            android:exported="false" />

    </application>

</manifest>