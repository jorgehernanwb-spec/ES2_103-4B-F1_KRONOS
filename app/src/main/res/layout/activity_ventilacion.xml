<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#101E19">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Barra superior con flecha de regreso y marca KRONOS -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnVolverAtrasVentilacion"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:gravity="center"
                android:text="←"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#E5CAA0"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver al panel principal"
                android:onClick="onVolverClick" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="KRONOS"
                android:fontFamily="serif"
                android:letterSpacing="0.16"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#E5CAA0" />

        </FrameLayout>

        <!-- Título y subtítulo -->
        <TextView
            android:id="@+id/txtTituloVentilacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Control de Ventilación"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtInvernaderoVentilacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 Invernadero 1"
                android:textColor="#E5CAA0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1B2D26"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="⚡ SIMULACIÓN IoT"
                android:textColor="#73D99A"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 1. Tarjeta: Estado Actual del Ventilador -->
        <LinearLayout
            android:id="@+id/cardEstadoVentilador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#243D30"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌀 SISTEMA DE VENTILACIÓN"
                    android:textColor="#A3B7AC"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtModoActualVentilacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modo: Automático"
                    android:textColor="#E5CAA0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtEstadoVentilador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Encendido"
                android:textColor="#73D99A"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetalleReglaVentilador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Auto: activo si Temp > 15 °C o Hum > 50 %"
                android:textColor="#A3B7AC"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- 2. Tarjeta: Modo de Operación y Control Manual -->
        <LinearLayout
            android:id="@+id/cardModoOperacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#243D30"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MODO DE OPERACIÓN"
                android:textColor="#E5CAA0"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swModoOperacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Modo Automático"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDescripcionModo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="En modo automático el estado del ventilador responde a las variables ambientales."
                android:textColor="#A3B7AC"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAlternarVentilador"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#358655"
                android:text="ENCENDER VENTILADOR (MANUAL)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 3. Tarjeta: Slider de Temperatura Simulada -->
        <LinearLayout
            android:id="@+id/cardTemperatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#243D30"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌡️ TEMPERATURA SIMULADA"
                    android:textColor="#A3B7AC"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtValorTemperaturaSlider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24.0 °C"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderTemperatura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:valueFrom="0.0"
                android:valueTo="40.0"
                android:stepSize="0.5"
                android:value="24.0"
                app:thumbColor="#73D99A"
                app:trackColorActive="#358655"
                app:trackColorInactive="#1B2D26" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 °C"
                    android:textColor="#769585"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Umbral auto: 15 °C"
                    android:textColor="#E5CAA0"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="40 °C"
                    android:textColor="#769585"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 4. Tarjeta: Slider de Humedad Simulada -->
        <LinearLayout
            android:id="@+id/cardHumedad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#243D30"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💧 HUMEDAD SIMULADA"
                    android:textColor="#A3B7AC"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtValorHumedadSlider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="65.0 %"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderHumedad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:valueFrom="0.0"
                android:valueTo="100.0"
                android:stepSize="1.0"
                android:value="65.0"
                app:thumbColor="#73D99A"
                app:trackColorActive="#358655"
                app:trackColorInactive="#1B2D26" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 %"
                    android:textColor="#769585"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Umbral auto: 50 %"
                    android:textColor="#E5CAA0"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="100 %"
                    android:textColor="#769585"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Botón Volver al panel principal -->
        <Button
            android:id="@+id/btnVolverPanelPrincipal"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#358655"
            android:onClick="onVolverClick"
            android:text="VOLVER AL PANEL PRINCIPAL"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="KRONOS · SISTEMA DE SEGURIDAD Y CONTROL"
            android:textColor="#769585"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
