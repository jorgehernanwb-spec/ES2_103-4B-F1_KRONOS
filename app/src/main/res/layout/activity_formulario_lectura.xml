<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#101E19">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/btnAtrasForm" android:layout_width="wrap_content" android:layout_height="48dp"
            android:gravity="center_vertical" android:text="‹  Volver al historial" android:textSize="19sp" android:textColor="#E5CAA0" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="KRONOS"
            android:fontFamily="serif" android:textStyle="bold" android:textSize="30sp" android:textColor="#E5CAA0" />
        <TextView android:id="@+id/txtTituloFormulario" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Nueva medición" android:textStyle="bold" android:textSize="23sp" android:textColor="#FFFFFF" android:layout_marginBottom="18dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Invernadero"
            android:textColor="#E5CAA0" android:textStyle="bold" />
        <Spinner android:id="@+id/spInvernaderoForm" android:layout_width="match_parent" android:layout_height="52dp"
            android:backgroundTint="#E5CAA0" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Temperatura (°C)"
            android:layout_marginTop="12dp" android:textColor="#E5CAA0" android:textStyle="bold" />
        <EditText android:id="@+id/edtTemperatura" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal|numberSigned" android:singleLine="true" android:hint="Ej.: 24.5"
            android:textColor="#FFFFFF" android:textColorHint="#9FB3A7" android:backgroundTint="#358655" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Humedad (%)"
            android:layout_marginTop="12dp" android:textColor="#E5CAA0" android:textStyle="bold" />
        <EditText android:id="@+id/edtHumedad" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:singleLine="true" android:hint="Ej.: 65"
            android:textColor="#FFFFFF" android:textColorHint="#9FB3A7" android:backgroundTint="#358655" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fecha y hora"
            android:layout_marginTop="12dp" android:textColor="#E5CAA0" android:textStyle="bold" />
        <EditText android:id="@+id/edtFechaHora" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="datetime" android:singleLine="true" android:hint="AAAA-MM-DD HH:MM:SS"
            android:textColor="#FFFFFF" android:textColorHint="#9FB3A7" android:backgroundTint="#358655" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swAutomaticoForm"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:text="Modo automático" android:textColor="#FFFFFF" android:checked="true" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swVentiladorForm"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Ventilador encendido (modo manual)" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/txtEstadoVentiladorForm" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:padding="12dp" android:background="#243D30"
            android:text="Ventilador: Encendido" android:textSize="16sp" android:textColor="#E5CAA0" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnGuardarLectura"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="Guardar medición" android:textColor="#FFFFFF" app:backgroundTint="#358655" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCancelarForm"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Cancelar y volver" android:textColor="#FFFFFF" app:backgroundTint="#465D4F" />
    </LinearLayout>
</ScrollView>
