<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="#243D30"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Invernadero y Fecha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtInvernaderoItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Invernadero 1"
                android:textColor="#E5CAA0"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtFechaHoraItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08/10/2026 15:30"
                android:textColor="#A3B7AC"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Mediciones: Temperatura y Humedad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTemperaturaItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌡️ 24.5 °C"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHumedadItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="💧 65.0 %"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Estado del ventilador y Modo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtVentiladorItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌀 Vent: Encendido"
                android:textColor="#73D99A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtModoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="(Automático)"
                android:textColor="#A3B7AC"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Botón eliminar con tarro de basura -->
    <ImageButton
        android:id="@+id/btnEliminar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_delete"
        android:contentDescription="Eliminar medición"
        app:tint="#FF8A80" />

</LinearLayout>
