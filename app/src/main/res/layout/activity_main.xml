<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#101E19">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="600dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Logo provisional de KRONOS -->
        <TextView
            android:id="@+id/imgLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="⌛"
            android:textSize="60sp"
            android:background="#20392F"
            android:contentDescription="Logo de Kronos" />

        <!-- Nombre con estilo clasico -->
        <TextView
            android:id="@+id/txtNombreKronos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="KRONOS"
            android:fontFamily="serif"
            android:letterSpacing="0.16"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#E5CAA0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="MONITOREO INTELIGENTE DE INVERNADEROS"
            android:textSize="11sp"
            android:letterSpacing="0.04"
            android:textColor="#A3B7AC"
            android:gravity="center" />

        <!-- Contenedor del formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="#1B2D26">

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bienvenido"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ingresa a tu sistema de monitoreo"
                android:textColor="#A3B7AC"
                android:textSize="14sp" />

            <!-- Correo electronico -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Correo electrónico"
                android:textColor="#C4D6CA"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtUsuario"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#73D99A"
                android:hint="correo@ejemplo.com"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#91A99A" />

            <!-- Contrasena -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Contraseña"
                android:textColor="#C4D6CA"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/edtPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="48dp"
                    android:backgroundTint="#73D99A"
                    android:hint="Ingresa tu contraseña"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#91A99A" />

                <ImageButton
                    android:id="@+id/btnMostrarPassword"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@android:color/transparent"
                    android:contentDescription="Mostrar u ocultar contraseña"
                    android:onClick="onMostrarPasswordClick"
                    android:src="@drawable/ic_visibility_24"
                    app:tint="#A3B7AC" />

            </FrameLayout>

            <!-- Recordarme -->
            <CheckBox
                android:id="@+id/chkRecordarme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="#73D99A"
                android:text="Recordarme"
                android:textColor="#C4D6CA" />

            <!-- Iniciar sesion -->
            <Button
                android:id="@+id/btnIngresar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#358655"
                android:onClick="onIngresarClick"
                android:text="INICIAR SESIÓN"
                android:textColor="#FFFFFF" />

            <!-- Limpiar -->
            <Button
                android:id="@+id/btnLimpiar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#34483D"
                android:onClick="onLimpiarClick"
                android:text="Limpiar campos"
                android:textColor="#FFFFFF" />

            <!-- Registro -->
            <Button
                android:id="@+id/btnIrARegistro"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#254D38"
                android:onClick="onIrARegistroClick"
                android:text="¿No tienes cuenta? Regístrate"
                android:textColor="#90DEAA" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="TEMPERATURA · HUMEDAD · VENTILACIÓN"
            android:textColor="#769585"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
